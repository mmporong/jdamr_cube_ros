<!--
  Since 2026-10-05: Lattice plans for the footprint (NavFn when it finds nothing)
  and MPPI follows on the live costmap. On the real map with the executor's waypoint
  headings Lattice ran 1.00-1.02x the waypoint chain (PC probe, 2026-10-05); the
  10-01 loops came with live obstacles in the global costmap. RPP on NavFn paths
  stays as navigate_through_poses_transit_rpp.xml (box_service rpp-transit switch).
  Transit through several waypoints as one goal (2026-10-01: separate
  NavigateToPose legs slowed to a stop and turned at every waypoint). Replan
  only when the path became invalid, is 10 s old, or the goals changed; a
  passed waypoint (within 0.35 m: MPPI passed one 0.31 m away on 2026-10-06 and
  Lattice planned a 5 m loop back to it) is dropped first. The last pose keeps its
  yaw through the general goal checker.
-->
<!--
  A passed waypoint is dropped on every 1 Hz tick, ahead of the replan check, and the
  changed goals replan at once (GlobalUpdatedGoal). 2026-10-06 16:48: dropped only
  when a replan ran (every 10 s), the base passed home_exit 0.16 m away between two
  replans, the next path led back to it, and RPP turned around about 180 deg at each
  following replan for 80 s (eleven in-place turns, about 800 deg).
-->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="1" name="Transit">
      <PipelineSequence>
        <RateController hz="1.0">
          <Sequence>
            <ForceSuccess>
              <RemovePassedGoals input_goals="{goals}" output_goals="{goals}" radius="0.35"/>
            </ForceSuccess>
            <Fallback>
              <ReactiveSequence>
                <Inverter>
                  <PathExpiringTimer seconds="10" path="{path}"/>
                </Inverter>
                <Inverter>
                  <GlobalUpdatedGoal/>
                </Inverter>
                <IsPathValid path="{path}"/>
              </ReactiveSequence>
              <Fallback name="LatticeThenNavFn">
                <ComputePathThroughPoses goals="{goals}" path="{path}" planner_id="Lattice" error_code_id="{compute_path_error_code}" server_timeout="3000"/>
                <ComputePathThroughPoses goals="{goals}" path="{path}" planner_id="GridBased" error_code_id="{compute_path_error_code}" server_timeout="3000"/>
              </Fallback>
            </Fallback>
          </Sequence>
        </RateController>
        <FollowPath path="{path}" controller_id="MPPI" goal_checker_id="general_goal_checker" error_code_id="{follow_path_error_code}" server_timeout="3000"/>
      </PipelineSequence>
      <Sequence>
        <Fallback>
          <WouldAPlannerRecoveryHelp error_code="{compute_path_error_code}"/>
          <WouldAControllerRecoveryHelp error_code="{follow_path_error_code}"/>
        </Fallback>
        <Wait wait_duration="1.0"/>
      </Sequence>
    </RecoveryNode>
  </BehaviorTree>
</root>
