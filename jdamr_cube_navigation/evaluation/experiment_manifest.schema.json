{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mmporong.github.io/jdamr/experiment_manifest.schema.json",
  "title": "JD-AMR SLAM experiment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "phase",
    "purpose",
    "environment",
    "captured_at",
    "source",
    "software",
    "clock",
    "sensors",
    "tf_authority",
    "config",
    "motion",
    "outcome",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{5,79}$"
    },
    "phase": {
      "enum": ["phase0", "phase1", "phase2", "phase3", "phase4", "phase4b", "phase5", "phase6", "phase7", "phase8", "phase9"]
    },
    "purpose": {"type": "string", "minLength": 8},
    "environment": {"enum": ["simulation", "real", "offline_replay"]},
    "captured_at": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_id", "bag_uri", "bag_sha256"],
      "properties": {
        "dataset_id": {"type": "string", "minLength": 3},
        "bag_uri": {"type": "string", "minLength": 1},
        "bag_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "software": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_sha", "ros_distro", "packages"],
      "properties": {
        "git_sha": {"$ref": "#/$defs/sha256"},
        "ros_distro": {"const": "jazzy"},
        "packages": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string", "minLength": 1}
        }
      }
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "source", "verified", "offset_uncertainty_ms"],
      "properties": {
        "mode": {"enum": ["simulation", "wall"]},
        "source": {"type": "string", "minLength": 3},
        "verified": {"type": "boolean"},
        "offset_uncertainty_ms": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "sensors": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/sensor"}
    },
    "tf_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["map_to_odom_publishers", "odom_to_base_publishers"],
      "properties": {
        "map_to_odom_publishers": {
          "type": "array",
          "maxItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "odom_to_base_publishers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "config_sha256", "map_id"],
      "properties": {
        "backend": {"enum": ["none", "cartographer", "slam_toolbox", "amcl", "nav2"]},
        "config_sha256": {"$ref": "#/$defs/sha256"},
        "map_id": {"type": ["string", "null"]}
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initial_pose", "max_linear_mps", "max_angular_rps", "schedule_id"],
      "properties": {
        "initial_pose": {"$ref": "#/$defs/pose2d"},
        "max_linear_mps": {"type": "number", "minimum": 0},
        "max_angular_rps": {"type": "number", "minimum": 0},
        "schedule_id": {"type": "string", "minLength": 1}
      }
    },
    "randomization": {
      "type": ["object", "null"],
      "properties": {
        "seed": {"type": "integer", "minimum": 0},
        "theta": {"type": "object"}
      },
      "required": ["seed", "theta"],
      "additionalProperties": false
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "terminal_reason", "contact_count", "invalid_goal_count"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL", "INVALID"]},
        "terminal_reason": {"type": "string", "minLength": 1},
        "contact_count": {"type": "integer", "minimum": 0},
        "invalid_goal_count": {"type": "integer", "minimum": 0}
      }
    },
    "artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifact"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pose2d": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "yaw"],
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"},
        "yaw": {"type": "number"}
      }
    },
    "sensor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "topic", "frame_id", "timestamp_source", "calibration_id"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "topic": {"type": "string", "pattern": "^/"},
        "frame_id": {"type": "string", "minLength": 1},
        "timestamp_source": {"enum": ["sensor", "driver_estimated", "ros_receipt", "simulation_clock"]},
        "calibration_id": {"type": "string", "minLength": 1}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "uri", "sha256"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "uri": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
