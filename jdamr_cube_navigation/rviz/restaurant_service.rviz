Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 245; 247; 250
    Fixed Frame: map
    Frame Rate: 20
  Displays:
    - Class: rviz_default_plugins/Map
      Name: Saved Map
      Enabled: true
      Alpha: 1
      Topic:
        Value: /map
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/MarkerArray
      Name: Saved Keepout Reference - Red
      Enabled: true
      Topic:
        Value: /service_visualization/saved_keepout
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/MarkerArray
      Name: Tables and Home Heading
      Enabled: true
      Topic:
        Value: /service_visualization/destinations
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/LaserScan
      Name: Live LiDAR
      Enabled: true
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
      Size (m): 0.025
      Color: 190; 30; 30
      Color Transformer: FlatColor
      Style: Flat Squares
    - Class: rviz_default_plugins/RobotModel
      Name: Current Robot
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/Path
      Name: Nav2 Planned Path
      Enabled: true
      Color: 120; 40; 210
      Line Style: Lines
      Line Width: 0.03
      Topic:
        Value: /plan
    - Class: rviz_default_plugins/Map
      Name: Live Nav2 Keepout - disabled until navigation starts
      Enabled: false
      Alpha: 0.4
      Color Scheme: costmap
      Topic:
        Value: /keepout_filter_mask
        Durability Policy: Transient Local
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Service Area
      Target Frame: map
      Scale: 90
      X: 0.2
      Y: -0.1
Window Geometry:
  Width: 1250
  Height: 900
