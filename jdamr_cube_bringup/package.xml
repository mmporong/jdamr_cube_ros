<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>jdamr_cube_bringup</name>
  <version>0.0.0</version>
  <description>JD-AMR Cube real-hardware bringup and TF configuration</description>
  <maintainer email="jdedu@todo.todo">jdedu</maintainer>
  <license>Apache-2.0</license>

  <depend>robot_state_publisher</depend>
  <depend>joint_state_publisher</depend>
  <depend>jdamr_cube_description</depend>
  <depend>jdamr_base_driver</depend>
  <depend>ydlidar_g4_ros2</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
