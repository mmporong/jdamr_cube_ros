[Unit]
Description=JD-AMR disarmed box-approach preparation
After=network-online.target jdamr-base.service jdamr-box-rgbd.service
Requires=jdamr-base.service jdamr-box-rgbd.service
Wants=network-online.target

[Service]
Type=simple
User=lim
Environment=ROS_DOMAIN_ID=12
Environment=ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET
Environment=FASTDDS_BUILTIN_TRANSPORTS=UDPv4
EnvironmentFile=/etc/jdamr-box-approach.env
ExecStart=/bin/bash -c 'exec /bin/bash "$JDAMR_APPROACH_RELEASE/src/jdamr_cube_navigation/scripts/box_approach_prepare.sh"'
KillMode=mixed
KillSignal=SIGINT
TimeoutStopSec=10
# A failed/ended approach must never restart or arm itself.
Restart=no

[Install]
WantedBy=multi-user.target
