#!/bin/bash
# Retry only the Astra S hub port when boot-time USB enumeration fails.
set -eo pipefail

usb_id="${ASTRA_USB_ID:-2bc5:0402}"
port_disable="${ASTRA_USB_PORT_DISABLE:-/sys/bus/usb/devices/1-1:1.0/1-1-port2/disable}"
initial_wait_s="${ASTRA_USB_INITIAL_WAIT_S:-8}"
port_off_s="${ASTRA_USB_PORT_OFF_S:-2}"
recovery_wait_s="${ASTRA_USB_RECOVERY_WAIT_S:-12}"
retry_count="${ASTRA_USB_RETRY_COUNT:-2}"
force_recovery="${ASTRA_USB_FORCE_RECOVERY:-0}"
lsusb_bin="${LSUSB_BIN:-/usr/bin/lsusb}"
sleep_bin="${SLEEP_BIN:-/usr/bin/sleep}"
usb_sysfs_root="${ASTRA_USB_SYSFS_ROOT:-/sys/bus/usb/devices}"

for value in "$initial_wait_s" "$port_off_s" "$recovery_wait_s" "$retry_count"; do
  if [[ ! "$value" =~ ^[0-9]+$ ]]; then
    echo "Astra USB timing and retry values must be nonnegative integers" >&2
    exit 2
  fi
done
[[ "$force_recovery" = 0 || "$force_recovery" = 1 ]] || {
  echo "ASTRA_USB_FORCE_RECOVERY must be 0 or 1" >&2
  exit 2
}

camera_enumerated() {
  "$lsusb_bin" -d "$usb_id" >/dev/null 2>&1 || return 1

  usb_vendor="${usb_id%%:*}"
  usb_product="${usb_id#*:}"
  for device_path in "$usb_sysfs_root"/*; do
    [ -d "$device_path" ] || continue
    [ -r "$device_path/idVendor" ] || continue
    [ -r "$device_path/idProduct" ] || continue
    vendor="$(<"$device_path/idVendor")"
    product="$(<"$device_path/idProduct")"
    [ "${vendor,,}" = "${usb_vendor,,}" ] || continue
    [ "${product,,}" = "${usb_product,,}" ] || continue

    for descriptor in authorized bConfigurationValue \
        bNumConfigurations bNumInterfaces; do
      [ -r "$device_path/$descriptor" ] || continue 2
      value="$(<"$device_path/$descriptor")"
      value="${value//[[:space:]]/}"
      [[ "$value" =~ ^[0-9]+$ ]] || continue 2
      (( 10#$value > 0 )) || continue 2
    done
    [ -s "$device_path/descriptors" ] || continue

    for interface_path in "${device_path}":*; do
      [ -d "$interface_path" ] || continue
      [ -r "$interface_path/bInterfaceClass" ] || continue
      interface_class="$(<"$interface_path/bInterfaceClass")"
      interface_class="${interface_class//[[:space:]]/}"
      [ "${interface_class,,}" = ff ] || continue
      [ -r "$interface_path/bNumEndpoints" ] || continue
      endpoint_count="$(<"$interface_path/bNumEndpoints")"
      endpoint_count="${endpoint_count//[[:space:]]/}"
      [[ "$endpoint_count" =~ ^[0-9a-fA-F]+$ ]] || continue
      (( 16#$endpoint_count >= 2 )) || continue

      bulk_in_count=0
      for endpoint_path in "$interface_path"/ep_*; do
        [ -d "$endpoint_path" ] || continue
        [ -r "$endpoint_path/type" ] || continue
        [ -r "$endpoint_path/direction" ] || continue
        endpoint_type="$(<"$endpoint_path/type")"
        endpoint_direction="$(<"$endpoint_path/direction")"
        if [ "${endpoint_type,,}" = bulk ] && \
            [ "${endpoint_direction,,}" = in ]; then
          bulk_in_count=$((bulk_in_count + 1))
        fi
      done
      (( bulk_in_count >= 2 )) && return 0
    done
  done
  return 1
}

wait_for_camera() {
  remaining_s="$1"
  while [ "$remaining_s" -gt 0 ]; do
    camera_enumerated && return 0
    "$sleep_bin" 1
    remaining_s=$((remaining_s - 1))
  done
  camera_enumerated
}

port_disabled=0
reenable_port() {
  if [ "$port_disabled" = 1 ]; then
    if printf '0' >"$port_disable"; then
      port_disabled=0
      return 0
    fi
    echo "Astra USB port re-enable failed: $port_disable" >&2
    return 1
  fi
  return 0
}
finish() {
  status="$?"
  trap - EXIT
  if ! reenable_port && [ "$status" -eq 0 ]; then
    status=1
  fi
  exit "$status"
}
trap finish EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

if [ "$force_recovery" = 0 ] && wait_for_camera "$initial_wait_s"; then
  echo "Astra USB enumeration already valid: $usb_id"
  exit 0
fi
if [ ! -w "$port_disable" ]; then
  echo "Astra USB port control is unavailable: $port_disable" >&2
  exit 1
fi

attempt=1
while [ "$attempt" -le "$retry_count" ]; do
  echo "Astra USB recovery attempt $attempt/$retry_count on $port_disable"
  port_disabled=1
  printf '1' >"$port_disable"
  "$sleep_bin" "$port_off_s"
  printf '0' >"$port_disable"
  port_disabled=0
  if wait_for_camera "$recovery_wait_s"; then
    echo "Astra USB enumeration recovered: $usb_id"
    exit 0
  fi
  attempt=$((attempt + 1))
done

echo "Astra USB recovery failed after $retry_count attempts" >&2
exit 1
