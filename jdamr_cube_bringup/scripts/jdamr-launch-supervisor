#!/usr/bin/python3
"""Propagate ROS 2 launch child-process failures to the service manager."""

import os
import re
import signal
import subprocess
import sys
import threading
import time


PROCESS_DIED = re.compile(
    r"process has died \[pid \d+, exit code (-?\d+), cmd '")
INITIAL_STOP_GRACE_S = 1.5
TERM_GRACE_S = 1.5
KILL_GRACE_S = 1.0


def _signal_group(process, signum):
    """Signal only the launch process group owned by this supervisor."""
    try:
        os.killpg(process.pid, signum)
    except ProcessLookupError:
        pass


def _group_exists(process):
    """Return whether any process remains in the owned launch group."""
    process.poll()
    try:
        os.killpg(process.pid, 0)
    except ProcessLookupError:
        return False
    return True


def _wait_for_group(process, timeout_s):
    """Wait a bounded interval for the owned process group to disappear."""
    deadline = time.monotonic() + timeout_s
    while time.monotonic() < deadline:
        if not _group_exists(process):
            return True
        time.sleep(0.02)
    return not _group_exists(process)


def _stop_group(process, initial_signal):
    """Stop and reap the launch group within the systemd stop timeout."""
    _signal_group(process, initial_signal)
    if _wait_for_group(process, INITIAL_STOP_GRACE_S):
        return True
    if initial_signal != signal.SIGTERM:
        _signal_group(process, signal.SIGTERM)
        if _wait_for_group(process, TERM_GRACE_S):
            return True
    _signal_group(process, signal.SIGKILL)
    return _wait_for_group(process, KILL_GRACE_S)


def main():
    """Run one launch command and fail if ROS launch reports a child crash."""
    arguments = sys.argv[1:]
    if arguments[:1] == ['--']:
        arguments = arguments[1:]
    if not arguments:
        print('usage: jdamr-launch-supervisor -- COMMAND [ARG ...]',
              file=sys.stderr)
        return 2

    stop_signal = None
    child = None

    def forward_stop(signum, _frame):
        nonlocal stop_signal
        if stop_signal is None:
            stop_signal = signum

    signal.signal(signal.SIGINT, forward_stop)
    signal.signal(signal.SIGTERM, forward_stop)

    try:
        child = subprocess.Popen(
            arguments,
            env=os.environ,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            errors='replace',
            bufsize=1,
            start_new_session=True,
        )
    except OSError as error:
        print(f'failed to start launch command: {error}', file=sys.stderr)
        return 127

    crashed_processes = []
    crash_detected = threading.Event()

    def drain_output():
        """Relay launch output and notify the main loop of a child crash."""
        assert child.stdout is not None
        for line in child.stdout:
            print(line, end='', flush=True)
            match = PROCESS_DIED.search(line)
            if (
                    match
                    and int(match.group(1)) != 0
                    and stop_signal is None):
                crashed_processes.append(int(match.group(1)))
                crash_detected.set()

    assert child.stdout is not None
    output_thread = threading.Thread(target=drain_output, daemon=True)
    output_thread.start()

    group_stopped = True
    while child.poll() is None:
        if crash_detected.is_set():
            group_stopped = _stop_group(child, signal.SIGINT)
            break
        if stop_signal is not None:
            group_stopped = _stop_group(child, stop_signal)
            break
        time.sleep(0.02)

    returncode = child.poll()
    if _group_exists(child):
        group_stopped = _stop_group(child, signal.SIGTERM) and group_stopped
    try:
        returncode = child.wait(timeout=0.2)
    except subprocess.TimeoutExpired:
        group_stopped = False
        returncode = 1
    output_thread.join(timeout=0.5)

    if crashed_processes:
        print(
            'ROS 2 launch reported a child-process failure: '
            + ', '.join(str(code) for code in crashed_processes),
            file=sys.stderr,
        )
        return 1
    if stop_signal is not None and group_stopped:
        return 0
    if not group_stopped:
        print('launch process group did not stop within the bounded timeout',
              file=sys.stderr)
        return 1
    if returncode < 0:
        return 128 + abs(returncode)
    return returncode


if __name__ == '__main__':
    raise SystemExit(main())
