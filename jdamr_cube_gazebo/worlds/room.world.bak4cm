<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="room">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <!-- 배속 실측(2026-08-04, RTX 5050 + 단일코어 물리): 타깃 3.0을 걸어도
           실측 ~0.9가 상한이고, 가변 RTF는 CPU YOLO 추론(월 150ms)과 충돌해
           이미지-TF 각도 불일치로 탐색 미검출이 폭증한다(이미지 스탬프 TF 조회
           미사용 구조). 노드는 전부 sim-time이므로 더 좋은 하드웨어에서는 이
           값만 올리면 안전하게 가속된다. -->
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact">
    </plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu">
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 6m x 6m rectangular room made of four walls, so the lidar has
         something in range to build a map from. -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 3 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>6 0.1 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6 0.1 1.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -3 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>6 0.1 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6 0.1 1.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>3 0 0.5 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>6 0.1 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6 0.1 1.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-3 0 0.5 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>6 0.1 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6 0.1 1.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- A couple of obstacles in the middle so the map has interior features. -->
    <model name="obstacle_box_1">
      <static>true</static>
      <pose>1.2 0.8 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 0.6 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.6 0.8</size></box></geometry>
          <material><ambient>0.8 0.4 0.1 1</ambient><diffuse>0.8 0.4 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obstacle_cylinder_1">
      <static>true</static>
      <pose>-1.3 -1.0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.3</radius><length>0.8</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>0.8</length></cylinder></geometry>
          <material><ambient>0.1 0.4 0.8 1</ambient><diffuse>0.1 0.4 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- SO-101 팔 pick & place 데모용 물체(자유 강체). 팔의 짧은 리치(~0.2~0.3m)가 로봇 몸체
         반경(섀시 0.25m + 라이다 0.325m)을 넘지 못하므로, 바닥이 아니라 로봇 상판(cube top,
         z=0.15) 위에 바로 올려서 그 위 공간에서 집게 한다. 로봇은 (0,0,0)에 스폰되고 팔
         shoulder_pan=0 기준 +X 방향으로 뻗는다. -->
    <model name="pick_object">
    
      <pose>0.21 0 0.17 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.02</mass>
          <inertia>
            <ixx>6e-6</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>6e-6</iyy><iyz>0</iyz>
            <izz>6e-6</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <surface>
            <friction>
              <ode><mu>1.2</mu><mu2>1.2</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material><ambient>0.9 0.1 0.6 1</ambient><diffuse>0.9 0.1 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 추가 pick 대상들. 색을 다르게 해서 뎁스카메라 픽셀 pick(pick --at-pixel)으로
         개별로 골라 집을 수 있게 한다. 전부 로봇 상판(z=0.15) 위, 팔이 닿는 범위에 배치. -->
    <model name="pick_object_green">
      <pose>0.40 0.19 0.17 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.02</mass>
          <inertia><ixx>6e-6</ixx><ixy>0</ixy><ixz>0</ixz><iyy>6e-6</iyy><iyz>0</iyz><izz>6e-6</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material><ambient>0.1 0.7 0.1 1</ambient><diffuse>0.1 0.7 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pick_object_blue">
      <pose>0.20 -1.09 0.17 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.02</mass>
          <inertia><ixx>6e-6</ixx><ixy>0</ixy><ixz>0</ixz><iyy>6e-6</iyy><iyz>0</iyz><izz>6e-6</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material><ambient>0.1 0.3 0.9 1</ambient><diffuse>0.1 0.3 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pick_object_orange">
      <pose>0.14 1.0 0.17 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.02</mass>
          <inertia><ixx>6e-6</ixx><ixy>0</ixy><ixz>0</ixz><iyy>6e-6</iyy><iyz>0</iyz><izz>6e-6</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material><ambient>0.95 0.5 0.1 1</ambient><diffuse>0.95 0.5 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 쓰레기통: 윗면이 열린 사각 통(바닥판 + 4면 벽). 집은 물체를 넣는 place 목표.
         로봇 정면 바닥(x=0.34)에 두어 챠시 앞면(x=0.25)과 겹치지 않게 하고, 통 높이(0.18)를
         상판 높이(0.15)보다 살짝 높여 팔이 테두리 너머로 물체를 떨어뜨릴 수 있게 한다. -->
    <model name="trash_can">
      <static>true</static>
      <pose>0.34 1 0 0 0 0</pose>
      <link name="link">
        <!-- 바닥판 -->
        <collision name="bottom_col"><pose>0 0 0.006 0 0 0</pose><geometry><box><size>0.16 0.16 0.012</size></box></geometry></collision>
        <visual name="bottom_vis"><pose>0 0 0.006 0 0 0</pose><geometry><box><size>0.16 0.16 0.012</size></box></geometry>
          <material><ambient>0.3 0.3 0.32 1</ambient><diffuse>0.3 0.3 0.32 1</diffuse></material></visual>
        <!-- +x 벽 -->
        <collision name="wall_px_col"><pose>0.074 0 0.09 0 0 0</pose><geometry><box><size>0.012 0.16 0.18</size></box></geometry></collision>
        <visual name="wall_px_vis"><pose>0.074 0 0.09 0 0 0</pose><geometry><box><size>0.012 0.16 0.18</size></box></geometry>
          <material><ambient>0.35 0.35 0.38 1</ambient><diffuse>0.35 0.35 0.38 1</diffuse></material></visual>
        <!-- -x 벽 -->
        <collision name="wall_nx_col"><pose>-0.074 0 0.09 0 0 0</pose><geometry><box><size>0.012 0.16 0.18</size></box></geometry></collision>
        <visual name="wall_nx_vis"><pose>-0.074 0 0.09 0 0 0</pose><geometry><box><size>0.012 0.16 0.18</size></box></geometry>
          <material><ambient>0.35 0.35 0.38 1</ambient><diffuse>0.35 0.35 0.38 1</diffuse></material></visual>
        <!-- +y 벽 -->
        <collision name="wall_py_col"><pose>0 0.074 0.09 0 0 0</pose><geometry><box><size>0.16 0.012 0.18</size></box></geometry></collision>
        <visual name="wall_py_vis"><pose>0 0.074 0.09 0 0 0</pose><geometry><box><size>0.16 0.012 0.18</size></box></geometry>
          <material><ambient>0.35 0.35 0.38 1</ambient><diffuse>0.35 0.35 0.38 1</diffuse></material></visual>
        <!-- -y 벽 -->
        <collision name="wall_ny_col"><pose>0 -0.074 0.09 0 0 0</pose><geometry><box><size>0.16 0.012 0.18</size></box></geometry></collision>
        <visual name="wall_ny_vis"><pose>0 -0.074 0.09 0 0 0</pose><geometry><box><size>0.16 0.012 0.18</size></box></geometry>
          <material><ambient>0.35 0.35 0.38 1</ambient><diffuse>0.35 0.35 0.38 1</diffuse></material></visual>
      </link>
    </model>
    <!-- LeRobot 시연(svla_so101_pickplace) 모사 관측 카메라 2대 — 프레임 대조로
         근사한 시점. 로봇 고정 베이스(0.3, 0, yaw 0) + 테이블(~0.65, 높이 0.18) 기준.
         up: 로봇 후상방에서 작업 영역 내려보기 / side: 전좌측 테이블 높이에서 로봇 조망 -->
  </world>
</sdf>
