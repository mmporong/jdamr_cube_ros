<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="room">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <!-- 배속 실측(2026-08-04, RTX 5050 + 단일코어 물리): 타깃 3.0을 걸어도
           실측 ~0.9가 상한이고, 가변 RTF는 CPU YOLO 추론(월 150ms)과 충돌해
           이미지-TF 각도 불일치로 탐색 미검출이 폭증한다(이미지 스탬프 TF 조회
           미사용 구조). 노드는 전부 sim-time이므로 더 좋은 하드웨어에서는 이
           값만 올리면 안전하게 가속된다. -->
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact">
    </plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu">
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 6m x 6m rectangular room made of four walls, so the lidar has
         something in range to build a map from. -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 3 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>6 0.1 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6 0.1 1.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -3 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>6 0.1 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6 0.1 1.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>3 0 0.5 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>6 0.1 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6 0.1 1.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-3 0 0.5 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>6 0.1 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6 0.1 1.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- A couple of obstacles in the middle so the map has interior features. -->

    <!-- pick 대상 3색. 바닥(z=0.02)에 두고, 로봇(원점, +x 방향) 앞 0.52m 반경에
         방위각만 다르게 흩어 놓는다 — 색을 고르면 조금만 돌아 조금만 전진하면 닿는다.
             green  +30도 / orange 0도 / blue -30도
         반경 0.52는 파지 포켓 0.381보다 14cm 멀어 접근 주행이 한 번은 들어가되,
         제자리 회전 반경(약 0.29m) 밖이라 돌다가 큐브를 치지 않는다. -->
    <model name="pick_object_green">
      <pose>0.45 0.26 0.015 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.02</mass>
          <inertia><ixx>6e-6</ixx><ixy>0</ixy><ixz>0</ixz><iyy>6e-6</iyy><iyz>0</iyz><izz>6e-6</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.03 0.03 0.03</size></box></geometry>
          <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.03 0.03 0.03</size></box></geometry>
          <material><ambient>0.1 0.7 0.1 1</ambient><diffuse>0.1 0.7 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pick_object_blue">
      <pose>0.45 -0.26 0.015 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.02</mass>
          <inertia><ixx>6e-6</ixx><ixy>0</ixy><ixz>0</ixz><iyy>6e-6</iyy><iyz>0</iyz><izz>6e-6</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.03 0.03 0.03</size></box></geometry>
          <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.03 0.03 0.03</size></box></geometry>
          <material><ambient>0.1 0.3 0.9 1</ambient><diffuse>0.1 0.3 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pick_object_orange">
      <pose>0.52 0.00 0.015 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.02</mass>
          <inertia><ixx>6e-6</ixx><ixy>0</ixy><ixz>0</ixz><iyy>6e-6</iyy><iyz>0</iyz><izz>6e-6</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.03 0.03 0.03</size></box></geometry>
          <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.03 0.03 0.03</size></box></geometry>
          <material><ambient>0.95 0.5 0.1 1</ambient><diffuse>0.95 0.5 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 쓰레기통: 윗면이 열린 사각 통(바닥판 + 4면 벽). 집은 물체를 넣는 place 목표.
         벽 높이 0.18 → 0.09로 낮췄다. 운반 자세의 큐브 하단이 0.205라 종전에도 2.5cm
         여유였는데, 주행 흔들림에 벽에 걸린 적이 있다 — 절반이면 여유가 11.5cm가 된다.
         위치도 (0.34, 1.0)에서 (0.15, 0.62)로 당겼다. 로봇 원점에서 0.64m, 방위 76도라
         집은 뒤 한 번 돌아 0.28m만 가면 통 위다(운반 포켓 TRASH_POCKET_X=0.344 기준).
         제자리 회전 반경(약 0.29m) 밖이고 큐브 3개(반경 0.52, ±30도)와도 겹치지 않는다. -->
    <model name="trash_marker">
      <static>true</static>
      <pose>0.15 0.71 0.13 0 0 -1.570796</pose>
      <link name="link">
        <!-- 흰 바탕판(여백 포함). 마커 정면은 +x 방향이다. -->
        <collision name="plate_col"><geometry><box><size>0.004 0.13333 0.13333</size></box></geometry></collision>
        <visual name="plate_vis"><geometry><box><size>0.004 0.13333 0.13333</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse>
            <emissive>0.35 0.35 0.35 1</emissive></material></visual>
        <visual name="c0"><pose>0.00275 -0.04167 0.04167 0 0 0</pose><geometry><box><size>0.0015 0.01667 0.01667</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0 0 0 1</specular></material></visual>
        <visual name="c1"><pose>0.00275 -0.02500 0.04167 0 0 0</pose><geometry><box><size>0.0015 0.01667 0.01667</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0 0 0 1</specular></material></visual>
        <visual name="c2"><pose>0.00275 -0.00833 0.04167 0 0 0</pose><geometry><box><size>0.0015 0.01667 0.01667</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0 0 0 1</specular></material></visual>
        <visual name="c3"><pose>0.00275 0.00833 0.04167 0 0 0</pose><geometry><box><size>0.0015 0.01667 0.01667</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0 0 0 1</specular></material></visual>
        <visual name="c4"><pose>0.00275 0.02500 0.04167 0 0 0</pose><geometry><box><size>0.0015 0.01667 0.01667</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0 0 0 1</specular></material></visual>
        <visual name="c5"><pose>0.00275 0.04167 0.04167 0 0 0</pose><geometry><box><size>0.0015 0.01667 0.01667</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0 0 0 1</specular></material></visual>
        <visual name="c6"><pose>0.00275 -0.04167 0.02500 0 0 0</pose><geometry><box><size>0.0015 0.01667 0.01667</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0 0 0 1</specular></material></visual>
        <visual name="c7"><pose>0.00275 -0.00833 0.02500 0 0 0</pose><geometry><box><size>0.0015 0.01667 0.01667</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0 0 0 1</specular></material></visual>
        <visual name="c8"><pose>0.00275 0.04167 0.02500 0 0 0</pose><geometry><box><size>0.0015 0.01667 0.01667</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0 0 0 1</specular></material></visual>
        <visual name="c9"><pose>0.00275 -0.04167 0.00833 0 0 0</pose><geometry><box><size>0.0015 0.01667 0.01667</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0 0 0 1</specular></material></visual>
        <visual name="c10"><pose>0.00275 -0.02500 0.00833 0 0 0</pose><geometry><box><size>0.0015 0.01667 0.01667</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0 0 0 1</specular></material></visual>
        <visual name="c11"><pose>0.00275 0.00833 0.00833 0 0 0</pose><geometry><box><size>0.0015 0.01667 0.01667</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0 0 0 1</specular></material></visual>
        <visual name="c12"><pose>0.00275 0.04167 0.00833 0 0 0</pose><geometry><box><size>0.0015 0.01667 0.01667</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0 0 0 1</specular></material></visual>
        <visual name="c13"><pose>0.00275 -0.04167 -0.00833 0 0 0</pose><geometry><box><size>0.0015 0.01667 0.01667</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0 0 0 1</specular></material></visual>
        <visual name="c14"><pose>0.00275 -0.02500 -0.00833 0 0 0</pose><geometry><box><size>0.0015 0.01667 0.01667</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0 0 0 1</specular></material></visual>
        <visual name="c15"><pose>0.00275 -0.00833 -0.00833 0 0 0</pose><geometry><box><size>0.0015 0.01667 0.01667</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0 0 0 1</specular></material></visual>
        <visual name="c16"><pose>0.00275 0.04167 -0.00833 0 0 0</pose><geometry><box><size>0.0015 0.01667 0.01667</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0 0 0 1</specular></material></visual>
        <visual name="c17"><pose>0.00275 -0.04167 -0.02500 0 0 0</pose><geometry><box><size>0.0015 0.01667 0.01667</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0 0 0 1</specular></material></visual>
        <visual name="c18"><pose>0.00275 -0.02500 -0.02500 0 0 0</pose><geometry><box><size>0.0015 0.01667 0.01667</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0 0 0 1</specular></material></visual>
        <visual name="c19"><pose>0.00275 -0.00833 -0.02500 0 0 0</pose><geometry><box><size>0.0015 0.01667 0.01667</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0 0 0 1</specular></material></visual>
        <visual name="c20"><pose>0.00275 0.02500 -0.02500 0 0 0</pose><geometry><box><size>0.0015 0.01667 0.01667</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0 0 0 1</specular></material></visual>
        <visual name="c21"><pose>0.00275 0.04167 -0.02500 0 0 0</pose><geometry><box><size>0.0015 0.01667 0.01667</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0 0 0 1</specular></material></visual>
        <visual name="c22"><pose>0.00275 -0.04167 -0.04167 0 0 0</pose><geometry><box><size>0.0015 0.01667 0.01667</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0 0 0 1</specular></material></visual>
        <visual name="c23"><pose>0.00275 -0.02500 -0.04167 0 0 0</pose><geometry><box><size>0.0015 0.01667 0.01667</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0 0 0 1</specular></material></visual>
        <visual name="c24"><pose>0.00275 -0.00833 -0.04167 0 0 0</pose><geometry><box><size>0.0015 0.01667 0.01667</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0 0 0 1</specular></material></visual>
        <visual name="c25"><pose>0.00275 0.00833 -0.04167 0 0 0</pose><geometry><box><size>0.0015 0.01667 0.01667</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0 0 0 1</specular></material></visual>
        <visual name="c26"><pose>0.00275 0.02500 -0.04167 0 0 0</pose><geometry><box><size>0.0015 0.01667 0.01667</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0 0 0 1</specular></material></visual>
        <visual name="c27"><pose>0.00275 0.04167 -0.04167 0 0 0</pose><geometry><box><size>0.0015 0.01667 0.01667</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0 0 0 1</specular></material></visual>
      </link>
    </model>

    <model name="trash_can">
      <static>true</static>
      <pose>0.15 0.62 0 0 0 0</pose>
      <link name="link">
        <!-- 바닥판 -->
        <collision name="bottom_col"><pose>0 0 0.006 0 0 0</pose><geometry><box><size>0.16 0.16 0.012</size></box></geometry></collision>
        <visual name="bottom_vis"><pose>0 0 0.006 0 0 0</pose><geometry><box><size>0.16 0.16 0.012</size></box></geometry>
          <material><ambient>0.3 0.3 0.32 1</ambient><diffuse>0.3 0.3 0.32 1</diffuse></material></visual>
        <!-- +x 벽 -->
        <collision name="wall_px_col"><pose>0.074 0 0.045 0 0 0</pose><geometry><box><size>0.012 0.16 0.09</size></box></geometry></collision>
        <visual name="wall_px_vis"><pose>0.074 0 0.045 0 0 0</pose><geometry><box><size>0.012 0.16 0.09</size></box></geometry>
          <material><ambient>0.35 0.35 0.38 1</ambient><diffuse>0.35 0.35 0.38 1</diffuse></material></visual>
        <!-- -x 벽 -->
        <collision name="wall_nx_col"><pose>-0.074 0 0.045 0 0 0</pose><geometry><box><size>0.012 0.16 0.09</size></box></geometry></collision>
        <visual name="wall_nx_vis"><pose>-0.074 0 0.045 0 0 0</pose><geometry><box><size>0.012 0.16 0.09</size></box></geometry>
          <material><ambient>0.35 0.35 0.38 1</ambient><diffuse>0.35 0.35 0.38 1</diffuse></material></visual>
        <!-- +y 벽 -->
        <collision name="wall_py_col"><pose>0 0.074 0.045 0 0 0</pose><geometry><box><size>0.16 0.012 0.09</size></box></geometry></collision>
        <visual name="wall_py_vis"><pose>0 0.074 0.045 0 0 0</pose><geometry><box><size>0.16 0.012 0.09</size></box></geometry>
          <material><ambient>0.35 0.35 0.38 1</ambient><diffuse>0.35 0.35 0.38 1</diffuse></material></visual>
        <!-- -y 벽 -->
        <collision name="wall_ny_col"><pose>0 -0.074 0.045 0 0 0</pose><geometry><box><size>0.16 0.012 0.09</size></box></geometry></collision>
        <visual name="wall_ny_vis"><pose>0 -0.074 0.045 0 0 0</pose><geometry><box><size>0.16 0.012 0.09</size></box></geometry>
          <material><ambient>0.35 0.35 0.38 1</ambient><diffuse>0.35 0.35 0.38 1</diffuse></material></visual>
      </link>
    </model>
    <!-- LeRobot 시연(svla_so101_pickplace) 모사 관측 카메라 2대 — 프레임 대조로
         근사한 시점. 로봇 고정 베이스(0.3, 0, yaw 0) + 테이블(~0.65, 높이 0.18) 기준.
         up: 로봇 후상방에서 작업 영역 내려보기 / side: 전좌측 테이블 높이에서 로봇 조망 -->
  </world>
</sdf>
