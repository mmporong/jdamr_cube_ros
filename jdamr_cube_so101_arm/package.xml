<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>jdamr_cube_so101_arm</name>
  <version>0.0.0</version>
  <description>SO-101 팔 관절 각도 제어 CLI. 관절 목표값을 주면 arm_controller/gripper_controller로 이동시킨다.</description>
  <maintainer email="jdedu.kr@gmail.com">jdedu</maintainer>
  <license>TODO: License declaration</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>jdamr_cube_gazebo</exec_depend>
  <exec_depend>jdamr_cube_description</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- 홈(원위치) 자세를 YAML 파일로 읽고 저장한다 (ui 명령의 홈 설정 버튼). -->
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_geometry_msgs</exec_depend>
  <!-- "pick 명령의 at-pixel 옵션"(MoveIt2 기반 픽셀 pick)에서만 지연 임포트로 사용.
       설치 안 돼 있어도 다른 명령(move/view/pick/place)은 정상 동작해야 한다. -->
  <exec_depend>moveit_py</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>jdamr_cube_moveit_config</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
