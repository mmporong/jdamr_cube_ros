<?xml version="1.0" ?>
<robot name="jdamr_cube">
    <link name="base_footprint"/>
    <link name="base_link">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <box size="0.5 0.3 0.15"/>
            </geometry>
            <material name="red">
                <color rgba="1 0 0 1"/>
            </material>
        </visual>
        
        <collision>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <box size="0.5 0.3 0.15"/>
            </geometry>
        </collision>
        
        <inertial>
            <mass value="3.0"/>
            <origin xyz="0 0 0"/>
            <inertia ixx="0.010" ixy="0.0" ixz="0.0" 
                     iyy="0.010" iyz="0.0" 
                     izz="0.010"/>
        </inertial>
    </link>

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 0.075" rpy="0 0 0"/>
    </joint>
    

    <joint name="left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel_link" />
        <!-- so101 팔이 앞쪽으로 이동하면서 무게중심도 앞으로 쏠려, 바퀴 축을 앞으로 옮겨 균형을 맞춤. -->
        <origin xyz="0.15 0.175 -0.008" rpy="0 0 0"/>
        <axis xyz="0 1 0" />
    </joint>
    <link name="left_wheel_link">
        <visual>
            <origin rpy="1.570795 0 0" xyz="0 0 0"/>
            <geometry>
                <cylinder length="0.05" radius="0.075"/>
            </geometry>
            <material name="yellow">
                <color rgba="1 1 0 1"/>
            </material>
        </visual>
        <collision>
            <origin rpy="1.570795 0 0" xyz="0 0 0"/>
            <geometry>
                <cylinder length="0.05" radius="0.075"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.0625"/>
            <origin rpy="1.570795 0 0" xyz="0 0 0"/>
            <inertia ixx="0.00009" ixy="0.0" ixz="0.0" iyy="0.00009" iyz="0.0" izz="0.00009"/>
        </inertial>
    </link>

    <joint name="right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel_link" />
        <origin xyz="0.15 -0.175 -0.008" rpy="0 0 0"/>
        <axis xyz="0 1 0" />
    </joint>
    <link name="right_wheel_link">
        <visual>
            <origin rpy="1.570795 0 0" xyz="0 0 0"/>
            <geometry>
                <cylinder length="0.05" radius="0.075"/>
            </geometry>
            <material name="yellow">
                <color rgba="1 1 0 1"/>
            </material>
        </visual>
        <collision>
            <origin rpy="1.570795 0 0" xyz="0 0 0"/>
            <geometry>
                <cylinder length="0.05" radius="0.075"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.0625"/>
            <origin rpy="1.570795 0 0" xyz="0 0 0"/>
            <inertia ixx="0.00009" ixy="0.0" ixz="0.0" iyy="0.00009" iyz="0.0" izz="0.00009"/>
        </inertial>
    </link>

    <joint name="caster_front_joint" type="fixed">
        <parent link="base_link"/>
        <child link="caster_link_front"/>
        <origin xyz="0.2 -0.0 -0.005" rpy="0 0 0"/>
    </joint>
    <link name="caster_link_front">
        <visual>
            <geometry><sphere radius="0.03"/></geometry>
            <material name="black"><color rgba="0 0 0 1"/></material>
        </visual>
        <collision>
            <geometry><sphere radius="0.03"/></geometry>
        </collision>
        <inertial>
            <mass value="0.03"/>
            <inertia ixx="0.00002" ixy="0.0" ixz="0.0" iyy="0.00002" iyz="0.0" izz="0.00002"/>
        </inertial>
        <gazebo reference="caster_link_front">
            <mu1>0.0</mu1>
            <mu2>0.0</mu2>
        </gazebo>
    </link>
    
    <joint name="caster_rear_joint" type="fixed">
        <parent link="base_link"/>
        <child link="caster_link_rear"/>
        <origin xyz="-0.2 -0.0 -0.005" rpy="0 0 0"/>
    </joint>
    <link name="caster_link_rear">
        <visual>
            <geometry><sphere radius="0.03"/></geometry>
            <material name="black"><color rgba="0 0 0 1"/></material>
        </visual>
        <collision>
            <geometry><sphere radius="0.03"/></geometry>
        </collision>
        <inertial>
            <mass value="0.03"/>
            <inertia ixx="0.00002" ixy="0.0" ixz="0.0" iyy="0.00002" iyz="0.0" izz="0.00002"/>
        </inertial>
        <gazebo reference="caster_link_rear">
            <mu1>0.0</mu1>
            <mu2>0.0</mu2>
        </gazebo>
    </link>

    <joint name="laser_joint" type="fixed">
        <origin xyz="0.3 0 0.15" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="laser_link"/>
    </joint>
    
    <link name="laser_link">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <cylinder length="0.05" radius="0.025"/>
            </geometry>
            <material name="black">
                <color rgba="1 0 0 1"/>
            </material>
        </visual>
        
        <collision>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <cylinder length="0.05" radius="0.025"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.05"/>
            <origin xyz="0 0 0"/>
            <inertia ixx="0.000006" ixy="0.0" ixz="0.0" iyy="0.000006" iyz="0.0" izz="0.000003"/>
        </inertial>
    </link>

     <gazebo>
        <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
            <left_joint>left_wheel_joint</left_joint>
            <right_joint>right_wheel_joint</right_joint>

            <wheel_separation>0.35</wheel_separation>
            <wheel_radius>0.075</wheel_radius>

            <max_linear_acceleration>1.0</max_linear_acceleration>

            <topic>cmd_vel</topic>

            <odom_topic>odom</odom_topic>
            <frame_id>odom</frame_id>
            <child_frame_id>base_footprint</child_frame_id>
            <odom_publisher_frequency>50</odom_publisher_frequency>

            <tf_topic>/tf</tf_topic>
        </plugin>
    </gazebo>
    <gazebo reference="laser_link">
        <sensor type="gpu_lidar" name="laser_sensor">
            <pose>0 0 0 0 0 0</pose>
            <visualize>true</visualize>
            <update_rate>10</update_rate>
            <always_on>true</always_on>
            <topic>scan</topic>
            <gz_frame_id>laser_link</gz_frame_id>
            <lidar>
                <scan>
                    <horizontal>
                        <samples>360</samples>
                        <resolution>1</resolution>
                        <!-- 라이다 정후방(180도)에는 팔을 받치는 리서 마스트(arm_riser_link)가
                             있어 완전한 360도를 스캔하면 자기 자신을 장애물로 감지한다. 팔을
                             앞으로 옮기면서 마스트가 라이다에 더 가까워져(약 0.12m) 사각지대를
                             넓힘. 실제 라이다 장착 브래킷처럼 후방에 사각지대(약 ±16도)를 둔다. -->
                        <min_angle>-2.862</min_angle> <max_angle>2.862</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.05</min>
                    <max>8.0</max>
                    <resolution>0.01</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.01</stddev>
                </noise>
            </lidar>
        </sensor>
    </gazebo>

    <gazebo>
        <plugin filename="gz-sim-joint-state-publisher-system"
                name="gz::sim::systems::JointStatePublisher">
            <topic>joint_states</topic>
            <joint_name>left_wheel_joint</joint_name>
            <joint_name>right_wheel_joint</joint_name>
        </plugin>
    </gazebo>

    <gazebo reference="base_link">
        <sensor name="imu_sensor" type="imu">
            <always_on>true</always_on>
            <update_rate>100.0</update_rate>
            <topic>imu/data</topic>
            <gz_frame_id>base_link</gz_frame_id>
            <imu>
                <angular_velocity>
                    <x><noise type="gaussian"><mean>0.0</mean><stddev>0.005</stddev></noise></x>
                    <y><noise type="gaussian"><mean>0.0</mean><stddev>0.005</stddev></noise></y>
                    <z><noise type="gaussian"><mean>0.0</mean><stddev>0.005</stddev></noise></z>
                </angular_velocity>
                <linear_acceleration>
                    <x><noise type="gaussian"><mean>0.0</mean><stddev>0.005</stddev></noise></x>
                    <y><noise type="gaussian"><mean>0.0</mean><stddev>0.005</stddev></noise></y>
                    <z><noise type="gaussian"><mean>0.0</mean><stddev>0.005</stddev></noise></z>
                </linear_acceleration>
            </imu>
        </sensor>
    </gazebo>

    <gazebo reference="base_link">
        <material>Gazebo/Red</material>
        <self_collide>true</self_collide>
    </gazebo>

    <!-- ================= SO-101 arm (TheRobotStudio/SO-ARM100, Apache-2.0) =================
         https://github.com/TheRobotStudio/SO-ARM100/tree/main/Simulation/SO101
         원본 URDF(so101_new_calib.urdf)의 링크/조인트에 "arm_" 접두사를 붙이고, base_link를
         jdamr_cube 몸체 위(base_link 상단면)에 고정 조인트로 얹은 것. 메쉬는
         meshes/so101/에 그대로 포함. -->
    <material name="so101_3d_printed">
        <color rgba="1.0 0.82 0.12 1.0"/>
    </material>
    <material name="so101_sts3215">
        <color rgba="0.1 0.1 0.1 1.0"/>
    </material>

    <!-- SO-101 팔 어깨 조립체(arm_base_link 기준 약 +0.06m 위)가 라이다 높이(base_link 상단
         기준 0.15, 절대 z=0.225)와 겹쳐서 라이다가 팔 자신을 장애물로 오인해 Nav2
         collision_monitor가 주행을 막는 문제가 있었다. 라이다는 원래 자리 그대로 두고, 대신
         팔을 몸체 위 마스트(리서)로 들어올려 팔 전체가 라이다보다 확실히 위(절대 z=0.30 이상)에
         오도록 한다. -->
    <!-- 팔을 몸체 앞쪽으로 옮겨 리치를 확보(로봇 앞쪽, 라이다(x=0.3)보다는 뒤쪽으로 0.15m
         여유를 둠). 무게중심 보정을 위해 바퀴 축도 앞으로 옮겼다(left/right_wheel_joint 참고). -->
    <joint name="arm_riser_joint" type="fixed">
        <parent link="base_link"/>
        <child link="arm_riser_link"/>
        <origin xyz="0.12 0 0.075" rpy="0 0 0"/>
    </joint>

    <link name="arm_riser_link">
        <inertial>
            <mass value="0.05"/>
            <origin xyz="0 0 0.075"/>
            <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0.075" rpy="0 0 0"/>
            <geometry>
                <box size="0.06 0.06 0.15"/>
            </geometry>
            <material name="black">
                <color rgba="0.1 0.1 0.1 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0.075" rpy="0 0 0"/>
            <geometry>
                <box size="0.06 0.06 0.15"/>
            </geometry>
        </collision>
    </link>

    <joint name="arm_mount_joint" type="fixed">
        <parent link="arm_riser_link"/>
        <child link="arm_base_link"/>
        <origin xyz="0 0 0.15" rpy="0 0 0"/>
    </joint>

    <!-- RGBD 카메라: 몸체 정중앙 상단에 마스트를 세워 so101 팔 전체보다 높은 위치(절대 z=0.75)에
         달고, 팔 앞쪽/아래 방향(작업 공간)을 내려다보도록 아래로 기울인다. 마스트가 로봇 중심
         (x=0)에 있어 라이다(x=0.3)에서 보면 arm_riser_link와 마찬가지로 정후방 방향이라, 이미
         있는 라이다 후방 사각지대(±16도)에 걸리므로 자기 감지 문제는 없다.
         마스트 높이는 기존 0.4m의 1.5배인 0.6m. -->
    <joint name="rgbd_mast_joint" type="fixed">
        <parent link="base_link"/>
        <child link="rgbd_mast_link"/>
        <origin xyz="0 0 0.075" rpy="0 0 0"/>
    </joint>

    <link name="rgbd_mast_link">
        <inertial>
            <mass value="0.05"/>
            <origin xyz="0 0 0.3"/>
            <inertia ixx="0.0002" ixy="0.0" ixz="0.0" iyy="0.0002" iyz="0.0" izz="0.0002"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0.3" rpy="0 0 0"/>
            <geometry>
                <box size="0.04 0.04 0.6"/>
            </geometry>
            <material name="black">
                <color rgba="0.1 0.1 0.1 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0.3" rpy="0 0 0"/>
            <geometry>
                <box size="0.04 0.04 0.6"/>
            </geometry>
        </collision>
    </link>

    <joint name="rgbd_camera_joint" type="fixed">
        <parent link="rgbd_mast_link"/>
        <child link="rgbd_camera_link"/>
        <!-- pitch +0.7rad(=40도)만큼 숙여 앞쪽/아래(팔 작업공간)를 내려다봄. -->
        <origin xyz="0 0 0.6" rpy="0 0.7 0"/>
    </joint>

    <link name="rgbd_camera_link">
        <inertial>
            <mass value="0.02"/>
            <origin xyz="0 0 0"/>
            <inertia ixx="1e-6" ixy="0.0" ixz="0.0" iyy="1e-6" iyz="0.0" izz="1e-6"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.03 0.08 0.03"/>
            </geometry>
            <material name="so101_sts3215"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.03 0.08 0.03"/>
            </geometry>
        </collision>
    </link>

    <gazebo reference="rgbd_camera_link">
        <sensor name="rgbd_camera" type="rgbd_camera">
            <pose>0 0 0 0 0 0</pose>
            <update_rate>15</update_rate>
            <always_on>true</always_on>
            <visualize>true</visualize>
            <topic>rgbd_camera</topic>
            <gz_frame_id>rgbd_camera_link</gz_frame_id>
            <camera>
                <horizontal_fov>1.15</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.1</near>
                    <far>10.0</far>
                </clip>
            </camera>
        </sensor>
    </gazebo>

    <link name="arm_base_link">
        <inertial>
            <origin xyz="0.0137179 -5.19711e-05 0.0334843" rpy="0 0 0"/>
            <mass value="0.147"/>
            <inertia ixx="0.000114686" ixy="-4.59787e-07" ixz="4.97151e-06" iyy="0.000136117" iyz="9.75275e-08" izz="0.000130364"/>
        </inertial>
        <visual>
            <origin xyz="-0.00636471 -9.94414e-05 -0.0024" rpy="1.5708 -1.67685e-15 1.5708"/>
            <geometry>
                <mesh filename="package://jdamr_cube_description/meshes/so101/base_motor_holder_so101_v1.stl"/>
            </geometry>
            <material name="so101_3d_printed"/>
        </visual>
        <collision>
            <origin xyz="-0.00636471 -9.94414e-05 -0.0024" rpy="1.5708 -1.67685e-15 1.5708"/>
            <geometry>
                <mesh filename="package://jdamr_cube_description/meshes/so101/base_motor_holder_so101_v1.stl"/>
            </geometry>
        </collision>
        <visual>
            <origin xyz="-0.00636471 -8.97657e-09 -0.0024" rpy="1.5708 -2.78073e-29 1.5708"/>
            <geometry>
                <mesh filename="package://jdamr_cube_description/meshes/so101/base_so101_v2.stl"/>
            </geometry>
            <material name="so101_3d_printed"/>
        </visual>
        <collision>
            <origin xyz="-0.00636471 -8.97657e-09 -0.0024" rpy="1.5708 -2.78073e-29 1.5708"/>
            <geometry>
                <mesh filename="package://jdamr_cube_description/meshes/so101/base_so101_v2.stl"/>
            </geometry>
        </collision>
        <visual>
            <origin xyz="0.0263353 -8.97657e-09 0.0437" rpy="-8.21148e-16 7.84513e-18 1.249e-15"/>
            <geometry>
                <mesh filename="package://jdamr_cube_description/meshes/so101/sts3215_03a_v1.stl"/>
            </geometry>
            <material name="so101_sts3215"/>
        </visual>
        <collision>
            <origin xyz="0.0263353 -8.97657e-09 0.0437" rpy="-8.21148e-16 7.84513e-18 1.249e-15"/>
            <geometry>
                <mesh filename="package://jdamr_cube_description/meshes/so101/sts3215_03a_v1.stl"/>
            </geometry>
        </collision>
        <visual>
            <origin xyz="-0.0309827 -0.000199441 0.0474" rpy="1.5708 -1.35493e-14 1.5708"/>
            <geometry>
                <mesh filename="package://jdamr_cube_description/meshes/so101/waveshare_mounting_plate_so101_v2.stl"/>
            </geometry>
            <material name="so101_3d_printed"/>
        </visual>
        <collision>
            <origin xyz="-0.0309827 -0.000199441 0.0474" rpy="1.5708 -1.35493e-14 1.5708"/>
            <geometry>
                <mesh filename="package://jdamr_cube_description/meshes/so101/waveshare_mounting_plate_so101_v2.stl"/>
            </geometry>
        </collision>
    </link>

    <link name="arm_shoulder_link">
        <inertial>
            <origin xyz="-0.0307604 -1.66727e-05 -0.0252713" rpy="0 0 0"/>
            <mass value="0.100006"/>
            <inertia ixx="8.3759e-05" ixy="7.55525e-08" ixz="-1.16342e-06" iyy="8.10403e-05" iyz="1.54663e-07" izz="2.39783e-05"/>
        </inertial>
        <visual>
            <origin xyz="-0.0303992 0.000422241 -0.0417" rpy="1.5708 1.5708 0"/>
            <geometry>
                <mesh filename="package://jdamr_cube_description/meshes/so101/sts3215_03a_v1.stl"/>
            </geometry>
            <material name="so101_sts3215"/>
        </visual>
        <collision>
            <origin xyz="-0.0303992 0.000422241 -0.0417" rpy="1.5708 1.5708 0"/>
            <geometry>
                <mesh filename="package://jdamr_cube_description/meshes/so101/sts3215_03a_v1.stl"/>
            </geometry>
        </collision>
        <visual>
            <origin xyz="-0.0675992 -0.000177759 0.0158499" rpy="1.5708 -1.5708 0"/>
            <geometry>
                <mesh filename="package://jdamr_cube_description/meshes/so101/motor_holder_so101_base_v1.stl"/>
            </geometry>
            <material name="so101_3d_printed"/>
        </visual>
        <collision>
            <origin xyz="-0.0675992 -0.000177759 0.0158499" rpy="1.5708 -1.5708 0"/>
            <geometry>
                <mesh filename="package://jdamr_cube_description/meshes/so101/motor_holder_so101_base_v1.stl"/>
            </geometry>
        </collision>
        <visual>
            <origin xyz="0.0122008 2.22413e-05 0.0464" rpy="-1.5708 2.35221e-33 0"/>
            <geometry>
                <mesh filename="package://jdamr_cube_description/meshes/so101/rotation_pitch_so101_v1.stl"/>
            </geometry>
            <material name="so101_3d_printed"/>
        </visual>
        <collision>
            <origin xyz="0.0122008 2.22413e-05 0.0464" rpy="-1.5708 2.35221e-33 0"/>
            <geometry>
                <mesh filename="package://jdamr_cube_description/meshes/so101/rotation_pitch_so101_v1.stl"/>
            </geometry>
        </collision>
    </link>

    <joint name="arm_shoulder_pan" type="revolute">
        <origin xyz="0.0388353 -8.97657e-09 0.0624" rpy="3.14159 4.18253e-17 -3.14159"/>
        <parent link="arm_base_link"/>
        <child link="arm_shoulder_link"/>
        <axis xyz="0 0 1"/>
        <limit effort="10" velocity="10" lower="-1.91986" upper="1.91986"/>
    </joint>

    <link name="arm_upper_arm_link">
        <inertial>
            <origin xyz="-0.0898471 -0.00838224 0.0184089" rpy="0 0 0"/>
            <mass value="0.103"/>
            <inertia ixx="4.08002e-05" ixy="-1.97819e-05" ixz="-4.03016e-08" iyy="0.000147318" iyz="8.97326e-09" izz="0.000142487"/>
        </inertial>
        <visual>
            <origin xyz="-0.11257 -0.0155 0.0187" rpy="-3.14159 -5.27356e-16 -1.5708"/>
            <geometry>
                <mesh filename="package://jdamr_cube_description/meshes/so101/sts3215_03a_v1.stl"/>
            </geometry>
            <material name="so101_sts3215"/>
        </visual>
        <collision>
