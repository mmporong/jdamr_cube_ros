    <!-- 손목 카메라(eye-in-hand). arm_wrist_link 로컬 프레임 기준 그리퍼(arm_gripper_frame_link)
         방향이 대략 -Y축이라 yaw -90도로 돌려서 카메라 정면(+X)이 그리퍼 쪽을 보게 함. -->
    <joint name="arm_wrist_camera_joint" type="fixed">
        <parent link="arm_wrist_link"/>
        <child link="arm_wrist_camera_link"/>
        <origin xyz="0 -0.11 0.03" rpy="0 0 -1.5708"/>
    </joint>

    <link name="arm_wrist_camera_link">
        <inertial>
            <mass value="0.005"/>
            <origin xyz="0 0 0"/>
            <inertia ixx="1e-7" ixy="0.0" ixz="0.0" iyy="1e-7" iyz="0.0" izz="1e-7"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.02 0.02 0.02"/>
            </geometry>
            <material name="so101_sts3215"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.02 0.02 0.02"/>
            </geometry>
        </collision>
    </link>

    <gazebo reference="arm_wrist_camera_link">
        <sensor name="wrist_camera" type="camera">
            <pose>0 0 0 0 0 0</pose>
            <update_rate>15</update_rate>
            <always_on>true</always_on>
            <visualize>true</visualize>
            <topic>wrist_camera/image_raw</topic>
            <gz_frame_id>arm_wrist_camera_link</gz_frame_id>
            <camera>
                <horizontal_fov>1.047</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.02</near>
                    <far>10</far>
                </clip>
            </camera>
        </sensor>
    </gazebo>

    <joint name="arm_wrist_flex" type="revolute">
        <origin xyz="-0.1349 0.0052 3.62355e-17" rpy="4.02456e-15 8.67362e-16 -1.5708"/>
        <parent link="arm_lower_arm_link"/>
        <child link="arm_wrist_link"/>
        <axis xyz="0 0 1"/>
        <limit effort="10" velocity="10" lower="-1.65806" upper="1.65806"/>
    </joint>

    <link name="arm_gripper_link">
        <inertial>
            <origin xyz="0.000213627 0.000245138 -0.025187" rpy="0 0 0"/>
            <mass value="0.087"/>
            <inertia ixx="2.75087e-05" ixy="-3.35241e-07" ixz="-5.7352e-06" iyy="4.33657e-05" iyz="-5.17847e-08" izz="3.45059e-05"/>
        </inertial>
        <visual>
            <origin xyz="0.0077 0.0001 -0.0234" rpy="-1.5708 -5.19179e-17 -1.66533e-16"/>
            <geometry>
                <mesh filename="package://jdamr_cube_description/meshes/so101/sts3215_03a_v1.stl"/>
            </geometry>
            <material name="so101_sts3215"/>
        </visual>
        <collision>
            <origin xyz="0.0077 0.0001 -0.0234" rpy="-1.5708 -5.19179e-17 -1.66533e-16"/>
            <geometry>
                <mesh filename="package://jdamr_cube_description/meshes/so101/sts3215_03a_v1.stl"/>
            </geometry>
        </collision>
        <visual>
            <origin xyz="8.32667e-17 -0.000218214 0.000949706" rpy="-3.14159 -5.55112e-17 0"/>
            <geometry>
                <mesh filename="package://jdamr_cube_description/meshes/so101/wrist_roll_follower_so101_v1.stl"/>
            </geometry>
            <material name="so101_3d_printed"/>
        </visual>
        <collision>
            <origin xyz="8.32667e-17 -0.000218214 0.000949706" rpy="-3.14159 -5.55112e-17 0"/>
            <geometry>
                <mesh filename="package://jdamr_cube_description/meshes/so101/wrist_roll_follower_so101_v1.stl"/>
            </geometry>
        </collision>
    </link>

    <joint name="arm_wrist_roll" type="revolute">
        <origin xyz="5.55112e-17 -0.0611 0.0181" rpy="1.5708 0.0486795 3.14159"/>
        <parent link="arm_wrist_link"/>
        <child link="arm_gripper_link"/>
        <axis xyz="0 0 1"/>
        <limit effort="10" velocity="10" lower="-2.74385" upper="2.84121"/>
    </joint>

    <link name="arm_gripper_frame_link">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="1e-9"/>
            <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
        </inertial>
    </link>

    <joint name="arm_gripper_frame_joint" type="fixed">
        <origin xyz="-0.0079 -0.000218121 -0.0981274" rpy="0 3.14159 0"/>
        <parent link="arm_gripper_link"/>
        <child link="arm_gripper_frame_link"/>
    </joint>

    <link name="arm_moving_jaw_link">
        <inertial>
            <origin xyz="-0.00157495 -0.0300244 0.0192755" rpy="0 0 0"/>
            <mass value="0.012"/>
            <inertia ixx="6.61427e-06" ixy="-3.19807e-07" ixz="-5.90717e-09" iyy="1.89032e-06" iyz="-1.09945e-07" izz="5.28738e-06"/>
        </inertial>
        <visual>
            <origin xyz="-5.55112e-17 -5.55112e-17 0.0189" rpy="9.53145e-17 6.93889e-18 1.24077e-24"/>
            <geometry>
                <mesh filename="package://jdamr_cube_description/meshes/so101/moving_jaw_so101_v1.stl"/>
            </geometry>
            <material name="so101_3d_printed"/>
        </visual>
        <collision>
            <origin xyz="-5.55112e-17 -5.55112e-17 0.0189" rpy="9.53145e-17 6.93889e-18 1.24077e-24"/>
            <geometry>
                <mesh filename="package://jdamr_cube_description/meshes/so101/moving_jaw_so101_v1.stl"/>
            </geometry>
        </collision>
    </link>

    <joint name="arm_gripper" type="revolute">
        <origin xyz="0.0202 0.0188 -0.0234" rpy="1.5708 -5.24284e-08 -1.41553e-15"/>
        <parent link="arm_gripper_link"/>
        <child link="arm_moving_jaw_link"/>
        <axis xyz="0 0 1"/>
        <limit effort="10" velocity="10" lower="-0.174533" upper="1.74533"/>
    </joint>

    <!-- ros2_control: gz_ros2_control이 gz-sim 조인트를 command/state 인터페이스로 노출.
         controller_manager 설정은 config/so101_controllers.yaml, 컨트롤러 로딩은
         jdamr_cube_gazebo/launch/gazebo.launch.py에서 수행. -->
    <ros2_control name="jdamr_cube_arm" type="system">
        <hardware>
            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>
        <joint name="arm_shoulder_pan">
            <command_interface name="position">
                <param name="min">-1.91986</param>
                <param name="max">1.91986</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="arm_shoulder_lift">
            <command_interface name="position">
                <param name="min">-1.74533</param>
                <param name="max">1.74533</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="arm_elbow_flex">
            <command_interface name="position">
                <param name="min">-1.69</param>
                <param name="max">1.69</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="arm_wrist_flex">
            <command_interface name="position">
                <param name="min">-1.65806</param>
                <param name="max">1.65806</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="arm_wrist_roll">
            <command_interface name="position">
                <param name="min">-2.74385</param>
                <param name="max">2.84121</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="arm_gripper">
            <command_interface name="position">
                <param name="min">-0.174533</param>
                <param name="max">1.74533</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
    </ros2_control>

    <gazebo>
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <parameters>package://jdamr_cube_description/config/so101_controllers.yaml</parameters>
        </plugin>
    </gazebo>

</robot>