    <joint name="arm_shoulder_lift" type="revolute">
        <origin xyz="-0.0303992 -0.0182778 -0.0542" rpy="-1.5708 -1.5708 0"/>
        <parent link="arm_shoulder_link"/>
        <child link="arm_upper_arm_link"/>
        <axis xyz="0 0 1"/>
        <limit effort="10" velocity="10" lower="-1.74533" upper="1.74533"/>
    </joint>

    <link name="arm_lower_arm_link">
        <inertial>
            <origin xyz="-0.0980701 0.00324376 0.0182831" rpy="0 0 0"/>
            <mass value="0.104"/>
            <inertia ixx="2.87438e-05" ixy="7.41152e-06" ixz="1.26409e-06" iyy="0.000159844" iyz="-4.90188e-08" izz="0.00014529"/>
        </inertial>
        <visual>
            <origin xyz="-0.0648499 -0.032 0.0182" rpy="3.14159 -0 6.67202e-31"/>
            <geometry>
                <mesh filename="package://jdamr_cube_description/meshes/so101/under_arm_so101_v1.stl"/>
            </geometry>
            <material name="so101_3d_printed"/>
        </visual>
        <collision>
            <origin xyz="-0.0648499 -0.032 0.0182" rpy="3.14159 -0 6.67202e-31"/>
            <geometry>
                <mesh filename="package://jdamr_cube_description/meshes/so101/under_arm_so101_v1.stl"/>
            </geometry>
        </collision>
        <visual>
            <origin xyz="-0.0648499 -0.032 0.018" rpy="-3.14159 -2.55351e-15 -1.83387e-30"/>
            <geometry>
                <mesh filename="package://jdamr_cube_description/meshes/so101/motor_holder_so101_wrist_v1.stl"/>
            </geometry>
            <material name="so101_3d_printed"/>
        </visual>
        <collision>
            <origin xyz="-0.0648499 -0.032 0.018" rpy="-3.14159 -2.55351e-15 -1.83387e-30"/>
            <geometry>
                <mesh filename="package://jdamr_cube_description/meshes/so101/motor_holder_so101_wrist_v1.stl"/>
